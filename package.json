{
  "name": "gx-dev",
  "version": "0.1.0",
  "type": "module",
  "description": "Deterministic, evidence-based multi-agent feature delivery for the pi coding agent.",
  "keywords": ["pi-package"],
  "pi": {
    "extensions": ["./extensions/gx-dev/index.ts"]
  },
  "license": "MIT",
  "engines": { "node": ">=24" },
  "files": [
    "extensions",
    "agents",
    "scripts",
    "PLAN.md",
    "README.md",
    "IMPLEMENTATION.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./extensions/gx-dev/index.ts"
  },
  "scripts": {
    "test": "node --test 'tests/unit/*.test.ts' 'tests/integration/*.test.ts' 'tests/e2e/*.test.ts'",
    "test:unit": "node --test 'tests/unit/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "sample": "node scripts/sample-workflow.mjs",
    "test:package": "node scripts/package-smoke.mjs",
    "check": "npm run typecheck && npm test && npm run sample && npm run test:package"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.2.0 <2",
    "@earendil-works/pi-tui": "*"
  }
}
